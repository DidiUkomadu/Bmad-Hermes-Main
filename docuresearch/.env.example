# LLM backend (any OpenAI-compatible /chat/completions endpoint).
# Copy to .env and fill in. Check your provider's docs for the exact base URL and model name.

# Nous Portal (Hermes models):
DOCURESEARCH_LLM_BASE_URL=https://inference-api.nousresearch.com/v1
DOCURESEARCH_LLM_MODEL=
DOCURESEARCH_LLM_API_KEY=

# Alternatives:
# OpenRouter:  DOCURESEARCH_LLM_BASE_URL=https://openrouter.ai/api/v1
# Ollama:      DOCURESEARCH_LLM_BASE_URL=http://localhost:11434/v1  (no API key needed)

# DOCURESEARCH_LLM_TIMEOUT=120
