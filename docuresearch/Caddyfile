# Caddy reverse proxy: automatic HTTPS for {$DOMAIN}, forwarding to the app.
{$DOMAIN} {
	encode gzip
	# Uploads are read in full by the app; cap request size.
	request_body {
		max_size 50MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}
	reverse_proxy app:8000
}
